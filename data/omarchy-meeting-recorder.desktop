[Desktop Entry]
Version=1.0
Name=Meeting Recorder
Keywords=meeting;recorder;record;transcribe;transcript;audio;voice;whisper;
Comment=Record a meeting in two tracks and transcribe it on this computer
Exec=omarchy-meeting-recorder %f
Terminal=false
Type=Application
Icon=audio-input-microphone
StartupWMClass=com.jankeesvw.OmarchyMeetingRecorder
StartupNotify=true
Categories=AudioVideo;Audio;Recorder;
MimeType=application/x-omarchy-meeting;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=omarchy-meeting-recorder new-window
